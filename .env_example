# Discord bot token
DISCORD_TOKEN=replace_with_discord_bot_token

# Read-only GitHub token. Limit it to the repository below.
GITHUB_TOKEN=replace_with_fine_grained_read_only_token

# OpenRouter API key
OPENROUTER_API_KEY=replace_with_openrouter_api_key

# Repository in owner/name format
GITHUB_REPO=Aparsa40/rudin-store

# OpenRouter model slug
AI_MODEL=openrouter/free

# Comma-separated Discord channel IDs where humans may talk to NEXUS.
# Leave empty until you have copied the target channel IDs from Discord.
NEXUS_CHANNEL_IDS=

# Channels where NEXUS records activity from other AI agents.
# Empty means use NEXUS_CHANNEL_IDS.
NEXUS_AGENT_CHANNEL_IDS=

# Optional comma-separated bot user IDs to observe.
# Empty means observe all non-NEXUS bots in NEXUS_AGENT_CHANNEL_IDS.
NEXUS_AGENT_BOT_IDS=

# Destination for scheduled reports. Empty disables scheduled publishing.
NEXUS_REPORT_CHANNEL_ID=

# Daily report time in 24-hour format; empty disables scheduled publishing.
NEXUS_REPORT_TIME=
NEXUS_REPORT_TIMEZONE=America/New_York

# Persistent activity database and retention policy.
NEXUS_DB_PATH=data/nexus-activity.sqlite3
NEXUS_ACTIVITY_RETENTION_DAYS=30

LOG_LEVEL=INFO
