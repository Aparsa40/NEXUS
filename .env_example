# Discord bot token
DISCORD_TOKEN=replace_with_discord_bot_token

# Read-only GitHub token. Limit it to the repository below.
GITHUB_TOKEN=replace_with_fine_grained_read_only_token

# OpenRouter API key
OPENROUTER_API_KEY=replace_with_openrouter_api_key

# Repository in owner/name format
GITHUB_REPO=Aparsa40/rudin-store

# OpenRouter model slug
AI_MODEL=openrouter/free

# Discord server/category context (category IDs are documentation only).
# Rudin Store category: 1566848595083264112
# AI Workspace category: 1566851015133892689
# General category: 1566848085542305922

# Human interaction channels: Rudin Store project channels + AI command/discussion.
NEXUS_CHANNEL_IDS=1566844463198896299,1566848874105282741,1566849163688153149,1566849334408912906,1566850798703349870,1566850877271183503,1566851205265891539,1566851396475691180

# Channels where messages from humans and other AI agents are observed.
NEXUS_AGENT_CHANNEL_IDS=1566844463198896299,1566848874105282741,1566849163688153149,1566849334408912906,1566850798703349870,1566850877271183503,1566851205265891539,1566851293656391710,1566851396475691180

# Shared channel where NEXUS relays updates from other AI agents.
# AI Workspace #ai-agent-logs
NEXUS_SYNC_CHANNEL_ID=1566851293656391710

# Optional comma-separated bot user IDs to observe.
# Empty means observe all non-NEXUS bots in the monitored channels.
NEXUS_AGENT_BOT_IDS=

# Destination for scheduled and on-demand project status reports.
# Rudin Store #rudin-store-status (verified from the open Discord server page)
NEXUS_REPORT_CHANNEL_ID=1566844463198896299

# Four reports per day, every six hours, in Asia/Tehran local time.
NEXUS_REPORT_TIMES=00:00,06:00,12:00,18:00
NEXUS_REPORT_TIMEZONE=Asia/Tehran

# Persistent activity database and retention policy.
NEXUS_DB_PATH=data/nexus-activity.sqlite3
NEXUS_ACTIVITY_RETENTION_DAYS=30

LOG_LEVEL=INFO
